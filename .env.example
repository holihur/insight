# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
DATA_DIR=./data

# ── Model provider ──────────────────────────────────────────────────────────
# auto | gemini | openai | mock
# auto picks Gemini when GOOGLE_API_KEY / GEMINI_API_KEY is set, then any
# OpenAI-compatible key, and finally falls back to the local demo engine.
INSIGHT_PROVIDER=auto

# Gemini (Google AI Studio)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/

# Any OpenAI-compatible endpoint (OpenAI, DeepSeek, OpenRouter, Ollama, vLLM…)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (auto-detected when DEEPSEEK_API_KEY is set)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# ── Limits ──────────────────────────────────────────────────────────────────
MAX_REPO_FILES=8000
GIT_CLONE_TIMEOUT=180
